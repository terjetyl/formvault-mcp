{
  "name": "@formvault/mcp",
  "version": "0.1.1",
  "description": "MCP server for FormVault — create and manage GDPR-compliant, EU-hosted forms from any MCP-compatible AI assistant.",
  "keywords": [
    "mcp",
    "modelcontextprotocol",
    "forms",
    "form-builder",
    "gdpr",
    "eu"
  ],
  "homepage": "https://formvault.eu/mcp",
  "license": "MIT",
  "type": "module",
  "bin": {
    "formvault-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:http": "tsx watch src/httpServer.ts",
    "start": "tsx src/index.ts",
    "start:http": "node dist/httpServer.js",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  },
  "mcpName": "io.github.terjetyl/formvault",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/terjetyl/formvault-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/terjetyl/formvault-mcp/issues"
  }
}
